{
  "name": "applemetafix",
  "version": "0.1.0",
  "description": "Apple Music based local music metadata enhancement tool",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test:apple-catalog": "tsx src/test/appleMusicCatalogTest.ts",
    "test:metadata-match": "tsx src/test/metadataMatchAppleTest.ts",
    "test:metadata-search": "tsx src/test/metadataSearchCliTest.ts",
    "test:local-pipeline": "tsx src/test/localMetadataPipelineTest.ts",
    "test:audio-reader": "tsx src/test/audioMetadataReaderTest.ts",
    "test:cache-management": "tsx src/test/cacheManagementTest.ts",
    "postinstall": "electron-builder install-app-deps",
    "test:candidate-ranking": "tsx src/test/metadataCandidateRankingTest.ts",
    "test:confirmed-candidate": "tsx src/test/confirmedCandidateMergeTest.ts",
    "test:apple-search-strategy": "tsx src/test/appleMusicSearchStrategyTest.ts",
    "test:metadata-repair-ranking": "tsx src/test/metadataRepairRankingTest.ts"
  },
  "keywords": [
    "music",
    "metadata",
    "apple-music",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^39.0.0",
    "electron-builder": "latest",
    "electron-vite": "^5.0.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "music-metadata": "latest",
    "react": "latest",
    "react-dom": "latest"
  }
}
