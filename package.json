{
  "name": "applemetafix",
  "version": "0.1.0",
  "description": "Apple Music based local music metadata enhancement tool",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test:local-pipeline": "tsx src/test/localMetadataPipelineTest.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": ["music", "metadata", "apple-music", "electron"],
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^39.0.0",
    "electron-builder": "latest",
    "electron-vite": "^5.0.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "music-metadata": "latest",
    "react": "latest",
    "react-dom": "latest"
  }
}
